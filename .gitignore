# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# animation frames (large assets)
/animation_frames

# original unoptimized assets (keep locally, don't deploy)
public/_originals/

# original full-size fonts (keep locally for re-subsetting)
/fonts-original/

# documentation (except README)
*.md
!README.md

# --- 3D working files -------------------------------------------------------
# Local scratch that must never enter git history: Blender sources, archived
# model experiments, and the uncompressed video original whose ~4 MB shipped
# version already lives in public/landing/videos.
.archive/
blender-bridge/
*.blend
*.blend1
*.orig.webm
*.orig.mov
