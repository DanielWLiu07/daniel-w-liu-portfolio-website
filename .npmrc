# Copy `file:` dependencies into node_modules instead of symlinking them.
#
# blender-to-threejs (the shader node system) lives in a sibling repo and is
# installed as a `file:` dependency. npm's default is a symlink, and Node
# resolves symlinks to their real path — which lands outside this project root.
# Turbopack only resolves within the project root, so a symlinked package is
# simply unresolvable here. Copying puts real files under node_modules where it
# can find them.
#
# Cost: an edit in the node repo needs `npm install` here to take effect.
install-links=true
