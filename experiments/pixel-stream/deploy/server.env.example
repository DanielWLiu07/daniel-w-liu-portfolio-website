# Copy to server.env (gitignored). deploy.sh uploads it next to server.mjs and
# systemd loads it. See server.mjs for every option.

# The page each seat renders. It must be a build that includes the intro-hold hook
# (components/resume/casino/intro-ready.ts): production after merging, or this
# branch's Vercel preview URL. Vercel deployment protection must allow it.
SITE_URL=https://your-site.example/resume

HEADLESS=1
SEATS=2                       # start low: video encoding is on the CPU on Linux
CODEC=VP8                     # A/B against H264 (OpenH264) on the instance
HOST=127.0.0.1                # Caddy is the only thing that reaches the server
PORT=8787
TRUST_PROXY=1                 # client IPs from Caddy's X-Forwarded-For
SPOT_WATCH=1                  # drain on Spot interruption notices

# Pages allowed to embed the viewer and call /api/seat (comma-separated).
EMBED_ORIGINS=https://your-site.example,http://localhost:3000

# Lab endpoints (/status, ?lab stats) need ?token=<this> when set.
LAB_TOKEN=change-me

# Optional TURN relay for networks that block direct UDP (Cloudflare Realtime TURN,
# first 1 TB/month free). Without these, STUN only.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# Seat reclaim (only while the pool is full); one seat per device, a lenient cap per IP.
IDLE_MS=120000
IDLE_GRACE_MS=20000
MAX_SEATS_PER_CLIENT=3

# Wake-on-demand: shut the machine down (= EC2 stop, billing ends) after this long
# with no visitors, except inside the keep-on window (days 0=Sun..6=Sat, hours 0-24).
SELF_STOP=1
SELF_STOP_IDLE_MIN=30
KEEP_ON_DAYS=1-5
KEEP_ON_HOURS=9-21
KEEP_ON_TZ=America/Toronto
