# Copy to config.env (gitignored) and fill in. Read by aws-*.sh and deploy.sh on
# your machine; nothing here goes to the servers except via server.env.

AWS_PROFILE=portfolio-stream
AWS_REGION=ca-central-1            # Montreal: ~16 ms from Waterloo
INSTANCE_TYPE=g4dn.2xlarge         # T4 GPU, 8 vCPU (software video encode needs the CPU)
MARKET=spot                        # spot | on-demand
NAME=portfolio-stream              # fleet name: tags every resource; server n is "$NAME-n"
SSH_KEY=~/.ssh/portfolio-stream.pem

# Public host per server, {n} = server number. Leave empty for a first test over
# plain HTTP on each Elastic IP; set it once DNS A records point at those IPs and
# Caddy gets HTTPS certificates (required to embed in the HTTPS site).
#   stream-{n}.example.com  →  stream-1.example.com, stream-2.example.com…
STREAM_HOST_PATTERN=
# Or {ip}.sslip.io for free HTTPS names with no DNS setup.
# Per-server OS (default linux), e.g. OS_2=windows for a Windows/NVENC server.
