{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SeeTheFleet",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    },
    {
      "Sid": "WakeOnlyFleetServers",
      "Effect": "Allow",
      "Action": "ec2:StartInstances",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/StreamFleet": "portfolio-stream" } }
    }
  ]
}
